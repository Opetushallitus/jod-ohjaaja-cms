# No usable default on purpose: dockerBuildTestImage in build.gradle passes this via
# --build-arg from gradle.properties. The sentinel below makes a build without that
# argument fail immediately with a self-explaining error, instead of silently running
# the integration tests against a stale Liferay version.
ARG LIFERAY_DOCKER_IMAGE=liferay-docker-image-build-arg-required
FROM ${LIFERAY_DOCKER_IMAGE}

ENV LIFERAY_WORKSPACE_ENVIRONMENT=test

# Copy portal.test bundle for LiferayIntegrationTestRule and related test utilities
COPY --chown=liferay:liferay portal-test-libs/com.liferay.portal.test.jar /opt/liferay/osgi/modules/

# Liferay Arquillian connector: installs and starts the test bundles (see docs/INTEGRATION_TESTS.md)
COPY --chown=liferay:liferay portal-test-libs/com.liferay.arquillian.extension.junit.bridge.connector.jar /opt/liferay/osgi/modules/

# Copy all application modules (excluding test modules)
COPY --chown=liferay:liferay deploy/*.jar /opt/liferay/osgi/modules/

# Healthy once the portal answers over HTTP and the Arquillian connector listens on port 32763
# (0x7FFB, state 0A = LISTEN in /proc/net/tcp*). The port is only looked up, never connected to:
# a probe that connects and closes without reading kills the connector's accept loop.
HEALTHCHECK --interval=5s --timeout=5s --start-period=30s --retries=120 \
  CMD curl -fs -o /dev/null http://localhost:8080/ && grep -qE ':7FFB 0+:0000 0A ' /proc/net/tcp /proc/net/tcp6

# 8080 - Liferay HTTP (not published by the tests; everything goes over loopback)
EXPOSE 8080

USER liferay:liferay
WORKDIR /opt/liferay
ENTRYPOINT ["/usr/local/bin/liferay_entrypoint.sh"]
