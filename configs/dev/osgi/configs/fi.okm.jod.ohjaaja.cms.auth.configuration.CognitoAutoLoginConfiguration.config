# fi.okm.jod.ohjaaja.cms.auth.configuration.CognitoAutoLoginConfiguration.config
# Values come from the ECS task environment (AWS_REGION is injected by Fargate). If any of them is
# missing, the AutoLogin stays disabled and Token Based SSO is not touched. Without logoutUrl the
# ALB and Cognito sessions stay active on logout and the user is logged in again.
albArn="$[env:JOD_ALB_ARN]"
clientId="$[env:JOD_COGNITO_CLIENT_ID]"
clockSkewSeconds=I"60"
enabled=B"true"
logoutUrl="$[env:JOD_LOGOUT_URL]"
region="$[env:AWS_REGION]"
userPoolId="$[env:JOD_COGNITO_USER_POOL_ID]"
